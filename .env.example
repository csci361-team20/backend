DATABASE_URL=postgresql+asyncpg://biletflow:biletflowpassword@db:5432/biletflow
# "production" refuses to start with the placeholder key or ORIGINS=["*"]
ENVIRONMENT=development
# Sites whose browsers may call the API directly
ORIGINS=["http://localhost:3000"]
# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-here
# Links in emails (verification, password reset) point here
FRONTEND_URL=http://localhost:3000
# Mailpit from docker-compose; set EMAIL_ENABLED=false to log emails instead
EMAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
# Uploads: "local" (./media, served at /api/v1/media) or "s3"
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8000
# For s3 locally: docker compose --profile storage up (SeaweedFS)
# S3_ENDPOINT_URL=http://localhost:8333
# S3_BUCKET=biletflow
# S3_ACCESS_KEY=any
# S3_SECRET_KEY=any
